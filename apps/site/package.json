{
  "name": "@govbb/site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Documentation site for the GovBB Design System (design-system.gov.bb).",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "pnpm --dir ../.. storybook:build:site && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@govtech-bb/frontend": "workspace:*",
    "astro": "^7.0.4",
    "astro-pagefind": "^2.0.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "cross-env": "^10.1.0",
    "typescript": "^5.7.0"
  }
}
