---
import { formatLogDate } from '../data/design-log';

/*
 * DesignLogEntry — one dated row in the design log.
 *
 * A log reads as a ledger, not a card grid: a date rail on the left, the
 * entry on the right, a hairline between rows. The kind chip sits in the
 * rail under the date so the entry column stays pure reading material.
 */
interface Props {
  date: Date;
  title: string;
  href: string;
  summary?: string;
  kind: 'decision' | 'research' | 'note';
}
const { date, title, href, summary, kind } = Astro.props;
const KIND_LABELS = { decision: 'Decision', research: 'Research', note: 'Note' };
---
<li class="govbb-logentry">
  <article class="govbb-logentry__row">
    <div class="govbb-logentry__rail">
      <p class="govbb-logentry__date">
        <time datetime={date.toISOString()}>{formatLogDate(date)}</time>
      </p>
      <p class={`govbb-logentry__kind govbb-logentry__kind--${kind}`}>
        {KIND_LABELS[kind]}
      </p>
    </div>
    <div class="govbb-logentry__body">
      <h3 class="govbb-logentry__title">
        <a href={href}>{title}</a>
      </h3>
      {summary && <p class="govbb-logentry__summary">{summary}</p>}
    </div>
  </article>
</li>

<style>
  .govbb-logentry {
    list-style: none;
    padding-block: var(--govbb-space-4);
  }
  .govbb-logentry + .govbb-logentry {
    border-top: 1px solid var(--govbb-color-border);
  }
  .govbb-logentry__row {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: var(--govbb-space-2) var(--govbb-space-5);
  }
  .govbb-logentry__rail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--govbb-space-2);
  }
  .govbb-logentry__date {
    margin: 0;
    /* aligns the date's cap height with the title's */
    padding-block-start: 0.3125rem;
    font-size: 1rem;
    color: var(--govbb-color-text-muted);
  }
  .govbb-logentry__kind {
    margin: 0;
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--govbb-color-text);
  }
  .govbb-logentry__kind--decision {
    background: var(--govbb-color-panel);
    color: var(--govbb-color-navy);
  }
  .govbb-logentry__kind--research {
    background: var(--govbb-card-teal);
  }
  .govbb-logentry__kind--note {
    background: var(--govbb-card-yellow);
  }
  .govbb-logentry__title {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.3;
    font-weight: 700;
    text-wrap: balance;
  }
  .govbb-logentry__title a {
    color: var(--govbb-color-teal);
    text-decoration: none;
    transition: color 150ms ease-out;
  }
  .govbb-logentry__title a:hover {
    text-decoration: underline;
  }
  .govbb-logentry__summary {
    margin: var(--govbb-space-2) 0 0;
    max-width: 65ch;
    color: var(--govbb-color-text-muted);
    text-wrap: pretty;
  }

  @media (max-width: 40rem) {
    .govbb-logentry__row {
      grid-template-columns: 1fr;
    }
    .govbb-logentry__rail {
      flex-direction: row;
      align-items: center;
      gap: var(--govbb-space-3);
    }
    .govbb-logentry__date {
      padding-block-start: 0;
    }
  }
</style>
