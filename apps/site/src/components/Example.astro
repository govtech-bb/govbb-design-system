---
import { Code } from 'astro:components';
// Inject the real design-system stylesheet into the preview iframe so examples
// render with the actual component styles (e.g. the real .govbb-btn button).
import libraryCss from '@govtech-bb/styles?raw';

/*
 * Example — a live component preview with the source shown beneath it.
 *
 * The preview is always visible: the example markup renders inside an <iframe>
 * (srcdoc) so its CSS is isolated from the page chrome. Directly below, a
 * language tab bar switches which source is shown — currently HTML and (when
 * provided) CSS. The tab set is data-driven (see `codeBlocks`) so future
 * languages (Web Component / React, per #124) can be added by extending the
 * array — no layout rewrite needed.
 */
interface Props {
  /** Example markup, rendered live and shown in the HTML source. */
  html: string;
  /** Component CSS: injected into the preview and shown in the CSS source. */
  css?: string;
  /** Accessible label for the example. */
  title?: string;
}
const { html, css = '', title } = Astro.props;

// Unique id so the tab/tabpanel ARIA relationships are scoped per instance.
const uid = 'ex-' + Math.random().toString(36).slice(2, 9);

const previewStyles = `
  html { color-scheme: light; }
  body {
    margin: 0;
    padding: 32px;
    min-height: 220px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: center;
    font-family: var(--govbb-font-base, system-ui, sans-serif);
    background: #fff;
  }
`;
const srcdoc = `<!doctype html><html lang="en"><head><meta charset="utf-8"><style>${libraryCss}\n${css}\n${previewStyles}</style></head><body>${html}</body></html>`;

// Data-driven source list — only render tabs for sources that exist.
const codeBlocks = [
  { label: 'HTML', lang: 'html' as const, code: html },
  ...(css ? [{ label: 'CSS', lang: 'css' as const, code: css }] : []),
];
---
<figure class="govbb-example" data-example>
  {title && <figcaption class="govbb-example__caption">{title}</figcaption>}

  <div class="govbb-example__preview">
    <iframe
      title={title ? `Preview: ${title}` : 'Component preview'}
      srcdoc={srcdoc}
      loading="lazy"
      data-example-frame
    ></iframe>
  </div>

  <div class="govbb-example__code">
    <div
      class="govbb-example__tabs"
      role="tablist"
      aria-label={title ? `${title} source` : 'Example source'}
    >
      {
        codeBlocks.map((block, i) => (
          <button
            id={`${uid}-tab-${block.lang}`}
            class="govbb-example__tab"
            role="tab"
            type="button"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`${uid}-panel-${block.lang}`}
            tabindex={i === 0 ? 0 : -1}
            data-lang={block.lang}
          >
            {block.label}
          </button>
        ))
      }
    </div>

    {
      codeBlocks.map((block, i) => (
        <div
          id={`${uid}-panel-${block.lang}`}
          class="govbb-example__panel"
          role="tabpanel"
          aria-labelledby={`${uid}-tab-${block.lang}`}
          tabindex="0"
          data-lang-panel={block.lang}
          hidden={i !== 0}
        >
          <div class="govbb-example__code-bar">
            <button class="govbb-example__copy" type="button" data-copy={block.code}>
              Copy
            </button>
          </div>
          <Code code={block.code} lang={block.lang} theme="github-light" />
        </div>
      ))
    }
  </div>
</figure>

<style>
  .govbb-example {
    margin: var(--govbb-space-5) 0;
  }
  .govbb-example__caption {
    font-weight: 600;
    margin-bottom: var(--govbb-space-2);
  }
  .govbb-example__preview {
    border: 1px solid var(--govbb-color-border);
    border-radius: var(--govbb-radius-lg) var(--govbb-radius-lg) 0 0;
    overflow: hidden;
  }
  .govbb-example__preview iframe {
    display: block;
    width: 100%;
    border: 0;
    min-height: 15rem;
  }
  .govbb-example__code {
    border: 1px solid var(--govbb-color-border);
    border-top: 0;
    border-radius: 0 0 var(--govbb-radius-lg) var(--govbb-radius-lg);
    overflow: hidden;
  }
  .govbb-example__tabs {
    display: flex;
    gap: var(--govbb-space-2);
    padding: 0 var(--govbb-space-3);
    background: var(--govbb-color-surface);
    border-bottom: 1px solid var(--govbb-color-border);
  }
  .govbb-example__tab {
    padding: var(--govbb-space-2) var(--govbb-space-3);
    font: inherit;
    font-size: 0.9rem;
    background: transparent;
    border: 0;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    cursor: pointer;
    color: var(--govbb-color-text-muted);
  }
  .govbb-example__tab[aria-selected='true'] {
    color: var(--govbb-color-teal);
    border-bottom-color: var(--govbb-color-teal);
    font-weight: 600;
  }
  .govbb-example__code-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: var(--govbb-space-2) var(--govbb-space-3);
    background: var(--govbb-color-surface);
    border-bottom: 1px solid var(--govbb-color-border);
  }
  .govbb-example__copy {
    padding: var(--govbb-space-1) var(--govbb-space-3);
    font: inherit;
    font-size: 0.85rem;
    background: var(--govbb-color-white);
    border: 1px solid var(--govbb-color-border);
    border-radius: var(--govbb-radius);
    cursor: pointer;
  }
  .govbb-example__code :global(pre) {
    margin: 0;
    padding: var(--govbb-space-3);
    max-height: 24rem;
    overflow: auto;
  }
</style>

<script>
  const examples = document.querySelectorAll<HTMLElement>('[data-example]');
  const frames: HTMLIFrameElement[] = [];

  const resizeFrame = (frame: HTMLIFrameElement) => {
    const doc = frame.contentDocument;
    if (doc?.body) {
      frame.style.height = `${doc.documentElement.scrollHeight}px`;
    }
  };

  examples.forEach((example) => {
    const tabs = Array.from(
      example.querySelectorAll<HTMLButtonElement>('.govbb-example__tab'),
    );
    const panels = example.querySelectorAll<HTMLElement>('[data-lang-panel]');
    const frame = example.querySelector<HTMLIFrameElement>('[data-example-frame]');

    const activate = (tab: HTMLButtonElement, focusTab = true) => {
      const lang = tab.dataset.lang;
      tabs.forEach((t) => {
        const selected = t === tab;
        t.setAttribute('aria-selected', String(selected));
        t.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.langPanel !== lang;
      });
      if (focusTab) tab.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(tab, false));
      // WAI-ARIA tabs keyboard pattern: arrow keys + Home/End move and select.
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next >= 0) {
          e.preventDefault();
          activate(tabs[next]);
        }
      });
    });

    example.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          const original = btn.textContent;
          btn.textContent = 'Copied';
          window.setTimeout(() => {
            btn.textContent = original;
          }, 1500);
        } catch {
          btn.textContent = 'Press Ctrl+C';
        }
      });
    });

    if (frame) {
      frames.push(frame);
      frame.addEventListener('load', () => resizeFrame(frame));
      // The srcdoc iframe may already have loaded before this deferred module
      // script ran, so size it now too rather than relying only on 'load'.
      if (frame.contentDocument?.readyState === 'complete') resizeFrame(frame);
    }
  });

  // One shared resize handler for all previews, throttled to a frame.
  let raf = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => frames.forEach(resizeFrame));
  });
</script>
