---
import { Code } from 'astro:components';
// Inject the real design-system stylesheet into the preview iframe so examples
// render with the actual component styles (e.g. the real .govbb-button button).
import libraryCss from '@govtech-bb/frontend/css?raw';

/*
 * Example — a live component preview with its source shown in a code panel.
 *
 * Top-level tabs switch between two views: the rendered Preview (an <iframe>
 * srcdoc so its CSS is isolated from the page chrome) and the Code view, a dark
 * panel with a language bar. The language set is data-driven (see `codeBlocks`)
 * so future languages (Web Component / React, per #124) can be added by
 * extending the array — no layout rewrite needed.
 */
interface Props {
  /** Example markup, rendered live and shown in the HTML source. */
  html: string;
  /** React source for the same example, shown in a React tab (not rendered —
      the preview is always the HTML, which the React wrappers emit). */
  react?: string;
  /** Component CSS: injected into the preview and shown in the CSS source. */
  css?: string;
  /** Accessible label for the example. */
  title?: string;
}
const { html, react, css = '', title } = Astro.props;

// Unique id so the tab/tabpanel ARIA relationships are scoped per instance.
const uid = 'ex-' + Math.random().toString(36).slice(2, 9);

const previewStyles = `
  html { color-scheme: light; }
  body {
    margin: 0;
    padding: 32px;
    box-sizing: border-box;
    min-height: 100vh;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: center;
    font-family: var(--govbb-font-sans, system-ui, sans-serif);
    background: #fff;
  }
`;
const srcdoc = `<!doctype html><html lang="en"><head><meta charset="utf-8"><style>${libraryCss}\n${css}\n${previewStyles}</style></head><body>${html}</body></html>`;

// Data-driven source list — only render tabs for sources that exist.
// React leads when present (the design system's primary consumer).
const codeBlocks = [
  ...(react ? [{ label: 'React', lang: 'tsx' as const, code: react }] : []),
  { label: 'HTML', lang: 'html' as const, code: html },
  ...(css ? [{ label: 'CSS', lang: 'css' as const, code: css }] : []),
];
---
<figure class="govbb-example" data-example>
  {title && <figcaption class="govbb-example__caption">{title}</figcaption>}

  <div class="govbb-example__views" role="tablist" aria-label={title ? `${title} view` : 'Example view'}>
    <button
      id={`${uid}-view-preview`}
      class="govbb-example__view-tab"
      role="tab"
      type="button"
      aria-selected="true"
      aria-controls={`${uid}-panel-preview`}
      tabindex="0"
      data-view="preview"
    >Preview</button>
    <button
      id={`${uid}-view-code`}
      class="govbb-example__view-tab"
      role="tab"
      type="button"
      aria-selected="false"
      aria-controls={`${uid}-panel-code`}
      tabindex="-1"
      data-view="code"
    >Code</button>
  </div>

  <div
    id={`${uid}-panel-preview`}
    class="govbb-example__preview"
    role="tabpanel"
    aria-labelledby={`${uid}-view-preview`}
    data-view-panel="preview"
  >
    <iframe
      title={title ? `Preview: ${title}` : 'Component preview'}
      srcdoc={srcdoc}
      loading="lazy"
      data-example-frame
    ></iframe>
  </div>

  <div
    id={`${uid}-panel-code`}
    class="govbb-example__code"
    role="tabpanel"
    aria-labelledby={`${uid}-view-code`}
    data-view-panel="code"
    hidden
  >
    <div class="govbb-example__bar">
      <div class="govbb-example__langs" role="tablist" aria-label="Language">
        {
          codeBlocks.map((block, i) => (
            <button
              id={`${uid}-tab-${block.lang}`}
              class="govbb-example__lang-tab"
              role="tab"
              type="button"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`${uid}-lang-${block.lang}`}
              tabindex={i === 0 ? 0 : -1}
              data-lang={block.lang}
            >
              {block.label}
            </button>
          ))
        }
      </div>
      <button class="govbb-example__copy" type="button">Copy</button>
    </div>

    {
      codeBlocks.map((block, i) => (
        <div
          id={`${uid}-lang-${block.lang}`}
          class="govbb-example__lang-panel"
          role="tabpanel"
          aria-labelledby={`${uid}-tab-${block.lang}`}
          tabindex="0"
          data-lang-panel={block.lang}
          data-code={block.code}
          hidden={i !== 0}
        >
          <Code code={block.code} lang={block.lang} theme="dark-plus" />
        </div>
      ))
    }
  </div>
</figure>

<style>
  .govbb-example {
    /* Shared so both views are the same height (no jump when toggling) and
       both tab rows are the same height (Preview/Code and HTML/React/Vue).
       Both views are pinned to --h and scroll internally — content taller
       than --h never changes the block's outer height. */
    --govbb-example-row-h: 44px;
    --govbb-example-bar-h: 36px;
    --govbb-example-h: 300px;
    --govbb-example-ease: cubic-bezier(0.23, 1, 0.32, 1);
    margin: var(--govbb-space-5) 0;
    display: flex;
    flex-direction: column;
    gap: var(--govbb-space-3);
  }
  .govbb-example__caption {
    font-weight: 600;
    margin-bottom: calc(var(--govbb-space-2) - var(--govbb-space-3));
  }

  /* Top-level Preview / Code tabs */
  .govbb-example__views {
    display: flex;
    border-bottom: 1px solid var(--govbb-color-border);
  }
  .govbb-example__view-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--govbb-example-row-h);
    padding: 0 var(--govbb-space-3);
    font: inherit;
    font-size: 0.875rem; /* 14px */
    font-weight: 500;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    cursor: pointer;
    /* The comp uses blue-40 (#99a8cc) here, but that's 2.4:1 on white — fails
       WCAG AA. Nearest passing muted token instead (7:1). */
    color: var(--govbb-color-text-muted);
    transition:
      color 150ms var(--govbb-example-ease),
      border-color 150ms var(--govbb-example-ease);
  }
  .govbb-example__view-tab:hover {
    color: var(--govbb-color-text);
  }
  .govbb-example__view-tab[aria-selected='true'] {
    color: var(--govbb-color-teal);
    border-bottom-color: var(--govbb-color-teal);
  }

  /* Preview panel — white card */
  .govbb-example__preview {
    height: var(--govbb-example-h);
    border: 1px solid var(--govbb-color-border);
    border-radius: var(--govbb-radius-lg);
    box-shadow: 0 2px 5px rgb(0 0 0 / 0.05);
    overflow: hidden;
    background: var(--govbb-color-white);
  }
  .govbb-example__preview iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Code view — white panel with a light language bar over a dark editor */
  .govbb-example__code {
    background: var(--govbb-color-white);
    border: 1px solid var(--govbb-color-border);
    border-radius: var(--govbb-radius-lg);
    overflow: hidden;
  }
  .govbb-example__bar {
    display: flex;
    align-items: stretch;
    height: var(--govbb-example-bar-h);
    background: #f8f9fa; /* bar grey from the Figma comp; no token this light */
  }
  .govbb-example__langs {
    display: flex;
  }
  .govbb-example__lang-tab,
  .govbb-example__copy {
    padding: 0 var(--govbb-space-3);
    font: inherit;
    font-size: 0.75rem; /* 12px */
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--govbb-mid-grey-00);
    transition:
      color 150ms var(--govbb-example-ease),
      background-color 150ms var(--govbb-example-ease),
      transform 120ms var(--govbb-example-ease);
  }
  .govbb-example__lang-tab[aria-selected='true'] {
    background: var(--govbb-color-white);
    color: var(--govbb-green-00);
    font-weight: 600;
    border-inline: 1px solid var(--govbb-color-border);
  }
  .govbb-example__lang-tab[aria-selected='true']:first-child {
    border-left: 0;
  }
  .govbb-example__copy {
    margin-left: auto;
  }
  .govbb-example__copy:hover,
  .govbb-example__lang-tab:hover {
    color: var(--govbb-color-text);
  }
  .govbb-example__copy:active {
    transform: scale(0.97);
  }

  /* Keyboard focus — borders are stripped, so restore a visible ring.
     GOV.UK compound ring (yellow bounded by dark) so it clears WCAG 2.4.11
     on both the white view tabs and the dark code bar. */
  .govbb-example__view-tab:focus-visible,
  .govbb-example__lang-tab:focus-visible,
  .govbb-example__copy:focus-visible {
    outline: 3px solid transparent;
    outline-offset: -3px;
    box-shadow:
      inset 0 0 0 2px var(--govbb-color-focus-site),
      inset 0 0 0 4px #0b0c0c;
  }
  .govbb-example__code :global(pre) {
    margin: 0;
    padding: var(--govbb-space-3) var(--govbb-space-4);
    /* Same total height as the preview view: --h − the language bar. */
    height: calc(var(--govbb-example-h) - var(--govbb-example-bar-h));
    overflow: auto;
    font-size: 0.8125rem;
    line-height: 1.6;
    background: #1e1e1e !important; /* pin Shiki dark-plus bg per the comp */
  }
  /* Line numbers — pure CSS counter over Shiki's per-line spans. */
  .govbb-example__code :global(pre code) {
    counter-reset: line;
  }
  .govbb-example__code :global(pre .line)::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 1.5rem;
    margin-right: var(--govbb-space-3);
    text-align: right;
    color: #8b949e; /* 5.6:1 on the #1e1e1e editor — #6e7681 failed AA */
    user-select: none; /* keep line numbers out of drag-selected copies */
  }

  @media (prefers-reduced-motion: reduce) {
    .govbb-example__copy:active {
      transform: none;
    }
  }
</style>

<script>
  import { initAll } from '@govtech-bb/frontend';

  const examples = document.querySelectorAll<HTMLElement>('[data-example]');

  // Behavioural components (number input, file upload) ship a PE runtime in
  // the frontend package. The srcdoc iframes are same-origin, so run initAll
  // against each preview document once it has loaded — previews then behave
  // like the real components, not just look like them.
  const enhanceFrame = (frame: HTMLIFrameElement) => {
    const doc = frame.contentDocument;
    if (doc) initAll(doc);
  };
  document
    .querySelectorAll<HTMLIFrameElement>('[data-example-frame]')
    .forEach((frame) => {
      frame.addEventListener('load', () => enhanceFrame(frame));
      if (frame.contentDocument?.readyState === 'complete') enhanceFrame(frame);
    });

  // Wire one WAI-ARIA tablist: click + arrow/Home/End move and select.
  const setupTabs = (
    tabs: HTMLButtonElement[],
    onActivate: (tab: HTMLButtonElement) => void,
  ) => {
    const activate = (tab: HTMLButtonElement, focusTab = true) => {
      tabs.forEach((t) => {
        const selected = t === tab;
        t.setAttribute('aria-selected', String(selected));
        t.tabIndex = selected ? 0 : -1;
      });
      onActivate(tab);
      if (focusTab) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(tab, false));
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next >= 0) {
          e.preventDefault();
          activate(tabs[next]);
        }
      });
    });
  };

  examples.forEach((example) => {
    // Top-level Preview / Code toggle.
    const viewTabs = Array.from(
      example.querySelectorAll<HTMLButtonElement>('.govbb-example__view-tab'),
    );
    const viewPanels = example.querySelectorAll<HTMLElement>('[data-view-panel]');
    setupTabs(viewTabs, (tab) => {
      viewPanels.forEach((p) => {
        p.hidden = p.dataset.viewPanel !== tab.dataset.view;
      });
    });

    // Language switcher inside the code view.
    const langTabs = Array.from(
      example.querySelectorAll<HTMLButtonElement>('.govbb-example__lang-tab'),
    );
    const langPanels = example.querySelectorAll<HTMLElement>('[data-lang-panel]');
    setupTabs(langTabs, (tab) => {
      langPanels.forEach((p) => {
        p.hidden = p.dataset.langPanel !== tab.dataset.lang;
      });
    });

    // Single copy button copies whichever language panel is visible.
    const copyBtn = example.querySelector<HTMLButtonElement>('.govbb-example__copy');
    copyBtn?.addEventListener('click', async () => {
      const active = example.querySelector<HTMLElement>(
        '[data-lang-panel]:not([hidden])',
      );
      try {
        await navigator.clipboard.writeText(active?.dataset.code ?? '');
        copyBtn.textContent = 'Copied';
        window.setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
      } catch {
        copyBtn.textContent = 'Press Ctrl+C';
      }
    });
  });
</script>
