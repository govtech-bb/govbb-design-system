---
// Official crest, SVGO-optimised from the design-system package's
// govbb-creast.svg (@govtech-bb/frontend). width/height match its intrinsic
// aspect ratio so the browser reserves space before it loads (no layout shift);
// CSS sizes the rendered crest.
import crest from '../assets/govbb-creast.svg?url';
const year = new Date().getFullYear();
---
<footer class="govbb-footer">
  <div class="govbb-container govbb-footer__inner">
    <nav aria-label="Footer">
      <ul class="govbb-footer__links">
        <li><a href="/">Home</a></li>
        <li><a href="/cookies/">Cookie Policy</a></li>
        <li><a href="/terms/">Terms &amp; Conditions</a></li>
        <li><a href="/sitemap/">Sitemap</a></li>
      </ul>
    </nav>
    <div class="govbb-footer__gov">
      <img
        class="govbb-footer__crest"
        src={crest}
        width="887"
        height="954"
        alt="Coat of arms of Barbados"
      />
      <p class="govbb-footer__copyright">© {year} Government of Barbados</p>
    </div>
  </div>
</footer>
