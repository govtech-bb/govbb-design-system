---
// Official crest, SVGO-optimised from the design-system package's
// govbb-creast.svg (@govtech-bb/styles). width/height match its intrinsic
// aspect ratio so the browser reserves space before it loads (no layout shift);
// CSS sizes the rendered crest.
import crest from '../assets/govbb-creast.svg?url';
---
<div class="govbb-gov-banner">
  <div class="govbb-container govbb-gov-banner__inner">
    <img
      class="govbb-gov-banner__crest"
      src={crest}
      width="887"
      height="954"
      alt="Coat of arms of Barbados"
    />
    <span>Official government website</span>
  </div>
</div>
