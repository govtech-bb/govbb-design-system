---
// Official crest ships with the design-system package (@govtech-bb/styles).
import crest from '@govtech-bb/styles/assets/images/govbb-creast.svg?url';
---
<div class="govbb-gov-banner">
  <div class="govbb-container govbb-gov-banner__inner">
    <img
      class="govbb-gov-banner__crest"
      src={crest}
      alt="Coat of arms of Barbados"
    />
    <span>Official government website</span>
  </div>
</div>
