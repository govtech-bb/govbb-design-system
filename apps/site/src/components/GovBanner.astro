---
// The design-system official-banner component; only the crest asset is local
// (SVGO-optimised copy of the package's govbb-crest.svg). width/height match
// its intrinsic aspect ratio so the browser reserves space before it loads.
import crest from '../assets/govbb-crest.svg?url';
---

<section
  class="govbb-official-banner"
  aria-label="Official government website"
>
  <div class="govbb-width-container govbb-official-banner__inner">
    <div class="govbb-official-banner__crest">
      <img
        class="govbb-official-banner__icon"
        src={crest}
        width="887"
        height="954"
        alt="Coat of arms of Barbados"
      />
    </div>
    <div class="govbb-official-banner__text">
      <span>Official government website</span>
    </div>
  </div>
</section>
