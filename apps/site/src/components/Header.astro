---
import type { Section } from '../types';
import { primaryNav } from '../data/nav';
import SearchBar from './SearchBar.astro';

interface Props {
  /** Top-level section key for highlighting the active nav item. */
  section?: Section;
}
const { section } = Astro.props;
---
<header class="site-header">
  <div class="govbb-width-container site-header__inner">
    <a class="site-brand" href="/">GovBB Design System</a>
    <SearchBar compact id="header-search" label="Search the design system" />
  </div>
  <nav class="site-nav" aria-label="Primary">
    <ul class="govbb-width-container">
      {
        primaryNav.map((link) => (
          <li>
            <a href={link.href} aria-current={section === link.key ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
