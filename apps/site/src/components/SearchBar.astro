---
/* Thin Astro wrapper around the frontend package's Search component markup. */
interface Props {
  /** Where the form submits. */
  action?: string;
  /** Accessible label for the input. */
  label?: string;
  placeholder?: string;
  buttonText?: string;
  /** Prefill (e.g. echo the current query on a results page). */
  value?: string;
  id?: string;
  /** Smaller variant for the header. */
  compact?: boolean;
  /** Package modifier for use on a coloured container. */
  borderless?: boolean;
}
const {
  action = '/search/',
  label = 'Search',
  placeholder = '',
  buttonText = 'Search',
  value = '',
  id = 'search',
  compact = false,
  borderless = false,
} = Astro.props;
---
<form
  class:list={[
    'govbb-search',
    'site-search',
    {
      'site-search--compact': compact,
      'govbb-search--borderless': borderless,
    },
  ]}
  role="search"
  action={action}
  method="get"
>
  <label class="govbb-visually-hidden" for={id}>{label}</label>
  <input
    class="govbb-search__input"
    id={id}
    type="search"
    name="q"
    value={value}
    placeholder={placeholder}
    autocomplete="off"
  />
  <button class="govbb-search__button" type="submit">{buttonText}</button>
</form>

<style>
  .site-search {
    max-inline-size: 37.5rem;
  }

  /* Layout-only docs-site variant. Visual and interaction states remain owned
     by the frontend package's .govbb-search component. */
  .site-search--compact {
    width: auto;
    max-width: none;
    margin-inline-start: auto;
  }
  .site-search--compact :global(.govbb-search__input) {
    flex: 0 1 auto;
    inline-size: 15rem;
    max-inline-size: 40vw;
    block-size: 2.75rem;
    padding-inline: var(--govbb-space-xs);
    font-size: var(--govbb-font-size-body-sm);
  }
  .site-search--compact :global(.govbb-search__button) {
    block-size: 2.75rem;
    padding-inline: var(--govbb-space-s);
    font-size: var(--govbb-font-size-body-sm);
  }

  @media (max-width: 50rem) {
    .site-search--compact {
      width: 100%;
      margin-inline-start: 0;
    }
    .site-search--compact :global(.govbb-search__input) {
      flex: 1 1 auto;
      inline-size: auto;
      min-inline-size: 0;
      max-inline-size: none;
    }
  }
</style>
