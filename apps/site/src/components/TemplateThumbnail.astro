---
import libraryCssUrl from '@govtech-bb/frontend/css?url';

interface Props {
  html: string;
  title: string;
}

const { html, title } = Astro.props;
const previewStyles = `
  html { color-scheme: light; background: #fff; }
  body {
    margin: 0;
    width: 250%;
    min-height: 660px;
    transform: scale(.4);
    transform-origin: top left;
    font-family: var(--govbb-font-sans, system-ui, sans-serif);
    background: #fff;
  }
`;
const srcdoc = `<!doctype html><html lang="en"><head><meta charset="utf-8"><link rel="stylesheet" href="${libraryCssUrl}"><style>${previewStyles}</style></head><body>${html}</body></html>`;
---

<div class="govbb-template-thumbnail" aria-hidden="true">
  <iframe
    title={`Preview of ${title}`}
    srcdoc={srcdoc}
    tabindex="-1"
    sandbox=""
  ></iframe>
</div>

<style>
  .govbb-template-thumbnail {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--govbb-color-border);
    background: var(--govbb-color-white);
  }

  .govbb-template-thumbnail iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }
</style>
