---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import OnThisPage from '../components/OnThisPage.astro';
import type { SidebarGroup } from '../components/Sidebar.astro';
import type { TocItem } from '../components/OnThisPage.astro';
import type { Section } from '../types';

interface Props {
  title: string;
  description?: string;
  section?: Section;
  pageTitle: string;
  pageSubtitle?: string;
  sidebarGroups: SidebarGroup[];
  sidebarLabel?: string;
  onThisPage?: TocItem[];
}
const {
  title,
  description,
  section,
  pageTitle,
  pageSubtitle,
  sidebarGroups,
  sidebarLabel,
  onThisPage,
} = Astro.props;
---
<BaseLayout title={title} description={description} section={section}>
  <div class="govbb-width-container govbb-article">
    <Sidebar groups={sidebarGroups} ariaLabel={sidebarLabel} />
    <div class="govbb-article__main">
      <div>
        <div class="govbb-page-header">
          <h1 class="govbb-page-title">{pageTitle}</h1>
          {pageSubtitle && <p class="govbb-page-subtitle">{pageSubtitle}</p>}
        </div>
        <slot />
      </div>
      {onThisPage && onThisPage.length > 0 && <OnThisPage items={onThisPage} />}
    </div>
  </div>
</BaseLayout>
