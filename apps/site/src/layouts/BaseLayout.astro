---
// Real design-system styles (workspace frontend package). Imported before
// global.css so the site's own chrome styles still win on any conflict.
// Provides the real tokens, the Figtree @font-face, and the component classes
// (e.g. .govbb-button*).
import '@govtech-bb/frontend/css';
import '../styles/global.css';
// Preload the latin subset so Figtree (font-display: swap) is fetched before
// the CSS parses — avoids a guaranteed FOUT on cold loads. Vite resolves this
// to the same hashed URL the bundled @font-face points at.
import figtreeLatinUrl from '@govtech-bb/frontend/assets/fonts/figtree-latin.woff2?url';
import GovBanner from '../components/GovBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Section } from '../types';

interface Props {
  title: string;
  description?: string;
  section?: Section;
  skipTarget?: string;
}
const {
  title,
  description,
  section,
  skipTarget = '#main-content',
} = Astro.props;
const fullTitle = `${title} - GovBB Design System`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {
      description && (
        <meta
          name="description"
          content={description}
          data-pagefind-meta="description[content]"
        />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href={figtreeLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="govbb-page">
    <a class="govbb-skip-link" href={skipTarget}>Skip to main content</a>
    <div data-pagefind-ignore>
      <GovBanner />
      <Header section={section} />
    </div>
    <main id="main-content" tabindex="-1" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
