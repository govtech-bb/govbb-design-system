---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getAiSkillsSidebar } from '../../data/nav';
import { getContentNeighbors } from '../../lib/content-navigation';
import {
  publishedSkills,
  skillSource,
  skillsCliCommand,
} from '../../lib/skills';

export async function getStaticPaths() {
  const entries = await publishedSkills();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { headings } = await render(entry);
const { title, status, requires } = entry.data.metadata;
const source = skillSource(entry.id);
if (entry.rendered?.html === undefined) {
  throw new Error(`${entry.id}: skill instructions were not rendered`);
}
// Code examples contain escaped tags; only actual Markdown anchors are rewritten.
const instructions = entry.rendered.html.replace(/<a href="([^"]+)"/g, (anchor, href) =>
  /^(?:[a-z][a-z\d+.-]*:|[/#?])/i.test(href)
    ? anchor
    : `<a href="${new URL(href, source.sourceUrl)}"`,
);

const onThisPage = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ label: h.text, href: `#${h.slug}` }));

// getContentNeighbors reads `data.title`, which every other collection has at
// the top level. A skill's human-facing title sits under `metadata`, so project
// it here rather than widening a helper five other sections depend on.
const entries = await publishedSkills();
const neighbors = getContentNeighbors(
  entries.map((e) => ({ id: e.id, data: { title: e.data.metadata.title } })),
  entry.id,
  '/ai-skills/',
);

const meta = [
  { label: 'Status', value: status === 'supported' ? 'Supported' : 'Experimental' },
  { label: 'Skill name', value: entry.data.name },
];
if (requires.length) meta.push({ label: 'Needs', value: requires.join(', ') });
---

<ArticleLayout
  title={title}
  section="ai-skills"
  description={entry.data.description}
  pageTitle={title}
  sidebarGroups={await getAiSkillsSidebar()}
  sidebarLabel="AI skills"
  source={source}
  onThisPage={onThisPage}
  breadcrumbs={[{ label: 'AI skills', href: '/ai-skills/' }]}
  meta={meta}
  previous={neighbors.previous}
  next={neighbors.next}
>
  <div class="govbb-prose">
    <h2 id="when-to-use-it">When to use it</h2>
    <p>{entry.data.description}</p>

    <h2 id="install">Install</h2>
    <p>
      Run this from your service project's directory, then choose your coding
      assistant. It installs this skill and its supporting files into the project:
    </p>
    <pre tabindex="0"><code>{skillsCliCommand(entry.id)}</code></pre>
    <p>
      Ask your assistant to use <code>{entry.data.name}</code> for the task.
      See <a href="/ai-skills/#install">installation guidance</a> if you are
      moving from the previous plugin installation.
    </p>
    {
      requires.length > 0 && (
        <p>
          It needs {requires.join(', ')} to do its job. Without those, the skill
          says so in its report rather than guessing — but you get less from it.
        </p>
      )
    }

    <h2 id="instructions">What the skill tells the AI to do</h2>
    <p>
      Below is the skill itself, unedited — the same text the AI loads. It is
      written as instructions to an agent rather than as guidance for you, which
      is why it reads the way it does. It is published in full so that anyone
      relying on the output can see exactly what standard was applied, and
      challenge it.
    </p>
    <p>
      The Markdown preview contains these main instructions only. The complete
      installation includes the <a href={`https://github.com/govtech-bb/govbb-design-system/tree/main/skills/${entry.id}`}>supporting references and scripts</a>.
    </p>
    <Fragment set:html={instructions} />
  </div>
</ArticleLayout>
