---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedChangelog, formatChangelogDate } from '../../data/changelog';

const posts = await getSortedChangelog();
---
<BaseLayout
  title="Changelog"
  section="changelog"
  description="Important design decisions, and why and when we made them."
>
  <section class="govbb-container govbb-page-section">
    <div class="govbb-page-header">
      <h1 class="govbb-page-title">Changelog</h1>
      <p class="govbb-page-subtitle">
        A record of important design decisions — what we decided, why, and when.
        Recording them means we don't have to relitigate them later.
      </p>
    </div>

    {
      posts.length === 0 ? (
        <p>No entries yet.</p>
      ) : (
        <div class="govbb-changelog-list">
          {posts.map((post) => (
            <div class="govbb-update">
              <p class="govbb-update__date">
                <time datetime={post.data.date.toISOString()}>
                  {formatChangelogDate(post.data.date)}
                </time>
              </p>
              <a class="govbb-update__title" href={`/changelog/${post.id}/`}>
                {post.data.title}
              </a>
              {post.data.summary && <p class="govbb-update__desc">{post.data.summary}</p>}
            </div>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .govbb-changelog-list {
    max-width: 44rem;
  }
  .govbb-changelog-list .govbb-update {
    margin-bottom: var(--govbb-space-5);
  }
</style>
