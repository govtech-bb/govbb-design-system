---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChangelogEntry from '../../components/ChangelogEntry.astro';
import { getSortedChangelog } from '../../data/changelog';

const posts = await getSortedChangelog();
---
<BaseLayout
  title="Changelog"
  section="changelog"
  description="Important design decisions, and why and when we made them."
>
  <section class="govbb-width-container govbb-page-section">
    <div class="govbb-page-header">
      <h1 class="govbb-page-title">Changelog</h1>
      <p class="govbb-page-subtitle">
        A record of important design decisions: what we decided, why, and when.
        Recording them means we don't have to relitigate them later.
      </p>
    </div>

    {
      posts.length === 0 ? (
        <p>No entries yet.</p>
      ) : (
        <div class="govbb-changelog-list">
          {posts.map((post) => (
            <ChangelogEntry
              date={post.data.date}
              title={post.data.title}
              href={`/changelog/${post.id}/`}
              summary={post.data.summary}
            />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .govbb-changelog-list {
    max-width: 44rem;
  }
  .govbb-changelog-list .govbb-update {
    margin-bottom: var(--govbb-space-5);
  }
</style>
