---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Example from '../../components/Example.astro';
import { getComponentsSidebar } from '../../data/nav';

export async function getStaticPaths() {
  const entries = await getCollection('components');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { headings } = await render(entry);

// "On this page" nav derived from the markdown's h2 headings.
const onThisPage = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ label: h.text, href: `#${h.slug}` }));

// Every ```html fence on a component page is a live example: the fence content
// is taken verbatim from the raw markdown (entry.body), and the corresponding
// syntax-highlighted <pre> in the rendered HTML is replaced with the <Example>
// component (preview iframe + code panel). An optional title="…" in the fence
// meta labels the example. A ```tsx fence directly after an html fence joins
// the same example as its React tab — the preview always renders the HTML,
// which is exactly what the React wrappers emit.
const fences = [
  ...(entry.body ?? '').matchAll(/^```(html|tsx)([^\n]*)\n([\s\S]*?)^```/gm),
].map((m) => ({
  lang: m[1],
  title: /title="([^"]*)"/.exec(m[2])?.[1],
  code: m[3].trim(),
}));
const parts = (entry.rendered?.html ?? '').split(/<pre[^>]*>[\s\S]*?<\/pre>/);
if (parts.length !== fences.length + 1) {
  throw new Error(
    `${entry.id}: found ${fences.length} html/tsx fences but ${parts.length - 1} rendered code blocks`,
  );
}

// Interleave prose chunks and examples, folding html+tsx fence pairs (nothing
// but whitespace between them) into a single example.
type Block =
  | { prose: string; example?: never }
  | { example: { title?: string; html: string; react?: string }; prose?: never };
const blocks: Block[] = [{ prose: parts[0] }];
for (let i = 0; i < fences.length; i++) {
  const fence = fences[i];
  if (fence.lang !== 'html') {
    throw new Error(`${entry.id}: \`\`\`tsx fence must directly follow an \`\`\`html fence`);
  }
  const example: { title?: string; html: string; react?: string } = {
    title: fence.title,
    html: fence.code,
  };
  if (fences[i + 1]?.lang === 'tsx' && parts[i + 1].trim() === '') {
    example.react = fences[i + 1].code;
    i++;
  }
  blocks.push({ example }, { prose: parts[i + 1] });
}
---
<ArticleLayout
  title={entry.data.title}
  section="components"
  description={entry.data.description}
  pageTitle={entry.data.title}
  pageSubtitle={entry.data.lede}
  sidebarGroups={await getComponentsSidebar()}
  sidebarLabel="Components"
  onThisPage={onThisPage}
>
  <div class="govbb-prose govbb-prose--article">
    {
      blocks.map((block) =>
        block.example ? (
          <Example
            html={block.example.html}
            react={block.example.react}
            title={block.example.title}
          />
        ) : (
          <Fragment set:html={block.prose} />
        ),
      )
    }
  </div>
</ArticleLayout>
