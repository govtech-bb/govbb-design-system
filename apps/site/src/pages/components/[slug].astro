---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Example from '../../components/Example.astro';
import { getComponentsSidebar } from '../../data/nav';
import { buildExampleBlocks } from '../../lib/example-blocks';
import { componentPageSource } from '../../lib/page-source';
import { getContentNeighbors } from '../../lib/content-navigation';

export async function getStaticPaths() {
  const entries = await getCollection('components');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { headings } = await render(entry);

// "On this page" nav derived from the markdown's h2 headings.
const onThisPage = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ label: h.text, href: `#${h.slug}` }));

const blocks = buildExampleBlocks(entry);
const entries = await getCollection('components');
entries.sort((a, b) => a.data.title.localeCompare(b.data.title));
const neighbors = getContentNeighbors(entries, entry.id, '/components/');
---

<ArticleLayout
  title={entry.data.title}
  section="components"
  description={entry.data.description}
  pageTitle={entry.data.title}
  pageSubtitle={entry.data.lede}
  sidebarGroups={await getComponentsSidebar()}
  sidebarLabel="Components"
  source={componentPageSource(entry.id)}
  onThisPage={onThisPage}
  breadcrumbs={[
    { label: 'Components', href: '/components/' },
    { label: entry.data.group },
  ]}
  meta={[
    { label: 'Examples', value: entry.body?.includes('```tsx') ? 'HTML and React' : 'HTML' },
    { label: 'Group', value: entry.data.group },
  ]}
  previous={neighbors.previous}
  next={neighbors.next}
>
  <div class="govbb-prose govbb-prose--article">
    {
      blocks.map((block) =>
        block.example ? (
          <Example
            html={block.example.html}
            react={block.example.react}
            title={block.example.title}
          />
        ) : (
          <Fragment set:html={block.prose} />
        ),
      )
    }

  </div>
</ArticleLayout>
