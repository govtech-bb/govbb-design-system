---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getComponentsSidebar, GROUP_ORDER } from '../../data/nav';

const entries = await getCollection('components');
entries.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Same grouping as the sidebar, so the page and the nav tell one story.
const groups = GROUP_ORDER.map((heading) => ({
  heading,
  entries: entries.filter((e) => e.data.group === heading),
})).filter((g) => g.entries.length > 0);
---
<ArticleLayout
  title="Components"
  section="components"
  description="Reusable, accessible parts of the user interface, with live examples and code."
  pageTitle="Components"
  pageSubtitle="Reusable parts of the user interface, with live examples and code."
  sidebarGroups={await getComponentsSidebar()}
  sidebarLabel="Components"
>
  <div class="govbb-prose">
    <p>
      Browse reusable parts of the interface. Every page includes a live HTML example,
      with React code when a wrapper exists in <code>@govtech-bb/react</code>.
    </p>
  </div>
  <div class="govbb-catalog-filter" data-catalog-filter>
    <label class="govbb-label" for="component-filter">Filter components</label>
    <p class="govbb-hint" id="component-filter-hint">Search by component name, purpose or group.</p>
    <input
      class="govbb-input govbb-catalog-filter__input"
      id="component-filter"
      type="search"
      autocomplete="off"
      aria-describedby="component-filter-hint component-filter-status"
      data-catalog-input
    />
    <p class="govbb-catalog-filter__status" id="component-filter-status" role="status" aria-live="polite" data-catalog-status>
      Showing all {entries.length} components.
    </p>
  </div>
  <p class="govbb-catalog-empty" data-catalog-empty hidden>
    No components match that search. Try a shorter term or browse a group below.
  </p>
  <div id="component-catalog">
  {
    groups.map((group) => (
      <section class="govbb-compgroup" data-catalog-group>
        <h2 class="govbb-compgroup__heading">{group.heading}</h2>
        <ul class="govbb-cardgrid">
          {group.entries.map((entry) => (
            <li data-catalog-item data-search={`${entry.data.title} ${entry.data.lede} ${entry.data.group}`.toLowerCase()}>
              <a class="govbb-compcard" href={`/components/${entry.id}/`}>
                <h3 class="govbb-compcard__title">{entry.data.title}</h3>
                <p class="govbb-compcard__desc">{entry.data.lede}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  </div>
</ArticleLayout>

<script>
  const catalog = document.querySelector<HTMLElement>('[data-catalog-filter]');
  const input = catalog?.querySelector<HTMLInputElement>('[data-catalog-input]');
  const status = catalog?.querySelector<HTMLElement>('[data-catalog-status]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-catalog-item]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-catalog-group]')];
  const empty = document.querySelector<HTMLElement>('[data-catalog-empty]');

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLocaleLowerCase();
    let visible = 0;

    for (const item of items) {
      const matches = !query || item.dataset.search?.includes(query);
      item.hidden = !matches;
      if (matches) visible++;
    }

    for (const group of groups) {
      group.hidden = !group.querySelector('[data-catalog-item]:not([hidden])');
    }

    if (empty) empty.hidden = visible !== 0;
    if (status) {
      status.textContent = query
        ? `${visible} component${visible === 1 ? '' : 's'} found.`
        : `Showing all ${items.length} components.`;
    }
  });
</script>
