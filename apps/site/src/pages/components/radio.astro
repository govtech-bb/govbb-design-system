---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Example from '../../components/Example.astro';
import { componentsSidebar } from '../../data/nav';
import defaultHtml from '../../examples/radio/default.html?raw';
import hintHtml from '../../examples/radio/hint.html?raw';
import conditionalHtml from '../../examples/radio/conditional.html?raw';

const onThisPage = [
  { label: 'Preview', href: '#preview' },
  { label: 'When to use', href: '#when-to-use' },
  { label: 'When not to use', href: '#when-not-to-use' },
  { label: 'Per-option hints', href: '#per-option-hints' },
  { label: 'Conditional reveal', href: '#conditional-reveal' },
  { label: 'Tips', href: '#tips' },
];
---
<ArticleLayout
  title="Radio"
  section="components"
  description="Use radio buttons to let users select a single option from a list."
  pageTitle="Radio"
  pageSubtitle="Radio buttons let users pick exactly one option from a short list."
  sidebarGroups={componentsSidebar}
  sidebarLabel="Components"
  onThisPage={onThisPage}
>
  <div class="govbb-prose">
    <h2 id="preview">Preview</h2>
  </div>
  <Example title="Radio group" html={defaultHtml.trim()} />

  <div class="govbb-prose">
    <p>
      The Radio component lets users pick exactly one option from a short list of
      mutually exclusive choices. Always wrap a group of radios in a
      <code>&lt;fieldset&gt;</code> with a <code>&lt;legend&gt;</code> that asks the
      question, since screen readers announce the legend with every option so users
      hear what they are answering.
    </p>

    <h2 id="when-to-use">When to use this component</h2>
    <p>
      Use radios when users must pick exactly one option and the list is short enough
      to show all options at once — roughly five or fewer. Put the most common or
      recommended option first, and fall back to alphabetical order only when no
      meaningful priority exists.
    </p>

    <h2 id="when-not-to-use">When not to use this component</h2>
    <p>
      Do not use radios when users can pick more than one option — use checkboxes
      instead. If the list of options is long, a select fits better than a full list
      of radios.
    </p>

    <h2 id="per-option-hints">Per-option hints</h2>
    <p>
      Add a hint to a single option to clarify its meaning. Use <code>aria-describedby</code>
      so screen readers announce it alongside the option's label.
    </p>
  </div>
  <Example title="Radio group with per-option hints" html={hintHtml.trim()} />

  <div class="govbb-prose">
    <h2 id="conditional-reveal">Conditional reveal</h2>
    <p>
      Show follow-up content when a specific option is selected. The conditional block
      sits as a sibling of its radio item and appears only when that radio is checked.
    </p>
  </div>
  <Example title="Radio group with conditional reveal" html={conditionalHtml.trim()} />

  <div class="govbb-prose">
    <h2 id="tips">Tips</h2>
    <p>
      Do not pre-select an answer. Letting users make an active choice ensures they
      give an answer they actually mean — pre-selecting an option skips the decision
      and can produce answers users did not intend to give.
    </p>
  </div>
</ArticleLayout>
