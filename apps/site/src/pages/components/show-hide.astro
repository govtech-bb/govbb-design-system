---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Example from '../../components/Example.astro';
import { componentsSidebar } from '../../data/nav';
import defaultHtml from '../../examples/show-hide/default.html?raw';
import openHtml from '../../examples/show-hide/open.html?raw';

const onThisPage = [
  { label: 'Preview', href: '#preview' },
  { label: 'When to use', href: '#when-to-use' },
  { label: 'When not to use', href: '#when-not-to-use' },
  { label: 'Writing the summary', href: '#writing-the-summary' },
  { label: 'Open by default', href: '#open-by-default' },
];
---
<ArticleLayout
  title="Show/Hide"
  section="components"
  description="Use show/hide to reveal secondary content on demand."
  pageTitle="Show/Hide"
  pageSubtitle="Reveal secondary content, such as help text, on demand."
  sidebarGroups={componentsSidebar}
  sidebarLabel="Components"
  onThisPage={onThisPage}
>
  <div class="govbb-prose">
    <h2 id="preview">Preview</h2>
  </div>
  <Example title="Show/Hide" html={defaultHtml.trim()} />

  <div class="govbb-prose">
    <p>
      The Show/Hide component is a disclosure that reveals secondary content when a
      user chooses to see it. It is useful for help text and other detail that not
      every user needs to read.
    </p>

    <h2 id="when-to-use">When to use this component</h2>
    <p>
      Use show/hide for supporting information that the average user can skip, such as
      help text, worked examples, or extra detail that only some users need.
    </p>

    <h2 id="when-not-to-use">When not to use this component</h2>
    <p>
      Do not hide content that users need in order to complete the task. If most users
      need the information, show it on the page rather than hiding it behind a
      disclosure.
    </p>

    <h2 id="writing-the-summary">Writing the summary</h2>
    <p>
      Write the summary as a descriptive noun phrase, such as <em
        >"What is a parish?"</em
      >, rather than a vague label like <em>"More info"</em>. The summary is built on
      the native <code>&lt;details&gt;</code> element, so keyboard and screen reader
      behaviour work without any extra scripting.
    </p>

    <h2 id="open-by-default">Open by default</h2>
    <p>
      A disclosure can start open if the content inside it is useful to most users but
      still optional to read. Use this sparingly — most disclosures should start
      closed.
    </p>
  </div>
  <Example title="Open by default" html={openHtml.trim()} />
</ArticleLayout>
