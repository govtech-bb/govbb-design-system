---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getDocumentationSidebar } from '../../data/nav';
import { pageSource } from '../../lib/page-source';
import { getContentNeighbors } from '../../lib/content-navigation';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const onThisPage = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ label: h.text, href: `#${h.slug}` }));
const entries = await getCollection('docs');
entries.sort((a, b) => a.data.title.localeCompare(b.data.title));
const neighbors = getContentNeighbors(entries, entry.id, '/documentation/');
---
<ArticleLayout
  title={entry.data.title}
  section="documentation"
  description={entry.data.description}
  pageTitle={entry.data.title}
  pageSubtitle={entry.data.lede}
  sidebarGroups={await getDocumentationSidebar()}
  sidebarLabel="Documentation"
  source={pageSource('documentation', entry.id)}
  onThisPage={onThisPage}
  breadcrumbs={[{ label: 'Get started', href: '/documentation/' }]}
  meta={[{ label: 'Type', value: 'Adoption guide' }]}
  previous={neighbors.previous}
  next={neighbors.next}
>
  <div class="govbb-prose govbb-prose--article">
    <Content />
  </div>
</ArticleLayout>
