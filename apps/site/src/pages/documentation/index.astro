---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ColorCard from '../../components/ColorCard.astro';

const cards = [
  {
    title: 'Using the design system',
    href: '/documentation/using-the-design-system/',
    modifier: 'pink' as const,
    desc: 'How to adopt the design system in a new or existing service.',
    link: 'Read the guide',
  },
  {
    title: 'Standards',
    href: '/documentation/using-the-design-system/#standards',
    modifier: 'lavender' as const,
    desc: 'What official Government of Barbados services must do.',
    link: 'View standards',
  },
  {
    title: 'Guidelines',
    href: '/documentation/using-the-design-system/#guidelines',
    modifier: 'teal' as const,
    desc: 'How and when to use the parts of the design system.',
    link: 'View guidelines',
  },
];
---
<BaseLayout
  title="Documentation"
  section="documentation"
  description="Standards and guidelines for how and when to use the design system."
>
  <section class="govbb-container govbb-page-section">
    <div class="govbb-page-header">
      <h1 class="govbb-page-title">Documentation</h1>
      <p class="govbb-page-subtitle">
        The standards and guidelines that govern official Government of Barbados
        services — how and when to use the design system.
      </p>
    </div>

    <ul class="govbb-cardgrid">
      {
        cards.map((card) => (
          <li>
            <ColorCard
              title={card.title}
              href={card.href}
              modifier={card.modifier}
              desc={card.desc}
              link={card.link}
            />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
