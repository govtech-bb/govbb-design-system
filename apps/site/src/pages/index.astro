---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardGrid from '../components/CardGrid.astro';
import type { CardData } from '../components/CardGrid.astro';

const cards: CardData[] = [
  {
    title: 'Components',
    href: '/components/',
    modifier: 'pink',
    desc: 'Reusable, accessible parts of the user interface, with live examples and code.',
    link: 'Browse components',
  },
  {
    title: 'Documentation',
    href: '/documentation/',
    modifier: 'lavender',
    desc: 'Standards and guidelines for how and when to use the design system.',
    link: 'Browse documentation',
  },
  {
    title: 'AI skills',
    href: '/ai-skills/',
    modifier: 'teal',
    desc: 'Guidance for designers working with AI tools. Coming soon.',
    link: 'View AI skills',
  },
  {
    title: 'Changelog',
    href: '/changelog/',
    modifier: 'yellow',
    desc: 'Dated updates and the design decisions behind the system.',
    link: 'View the changelog',
  },
];
---
<BaseLayout
  title="Home"
  description="The design system for official Government of Barbados services."
>
  <section class="govbb-width-container govbb-hero">
    <h1 class="govbb-hero__title">design-system.gov.bb</h1>
    <p class="govbb-hero__subtitle">
      The design system for official digital services of the Government of Barbados.
    </p>
    <div class="govbb-hero__cta">
      <a class="govbb-button" href="/documentation/">Get started</a>
      <a class="govbb-button govbb-button--tertiary" href="/components/"
        >Browse components</a
      >
    </div>
  </section>

  <section class="govbb-band govbb-band--pink">
    <div class="govbb-width-container">
      <h2 class="govbb-section-title">Explore the design system</h2>
      <CardGrid cards={cards} heading="h3" />
    </div>
  </section>

</BaseLayout>
