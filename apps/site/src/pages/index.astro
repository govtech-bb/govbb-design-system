---
import BaseLayout from '../layouts/BaseLayout.astro';

const startPaths = [
  {
    title: 'Adopting the system',
    href: '/documentation/',
    desc: 'Understand the standards, packages and recommended way to adopt the system.',
    link: 'Get started',
  },
  {
    title: 'Designing a service',
    href: '/patterns/',
    desc: 'Use patterns to solve common tasks, then start whole pages from templates.',
    link: 'Browse patterns',
  },
  {
    title: 'Building an interface',
    href: '/components/',
    desc: 'Find reusable components, live examples and HTML or React implementation guidance.',
    link: 'Browse components',
  },
];
---
<BaseLayout
  title="Home"
  description="The design system for official Government of Barbados services."
>
  <section class="govbb-width-container govbb-hero">
    <h1 class="govbb-hero__title">GovBB Design System</h1>
    <p class="govbb-hero__subtitle">
      A shared foundation for clear, accessible Government of Barbados digital services.
    </p>
    <div class="govbb-hero__cta">
      <a class="govbb-button" href="/documentation/">Get started</a>
      <a class="govbb-button govbb-button--tertiary" href="/components/">
        Browse components
      </a>
    </div>
  </section>

  <section class="govbb-band govbb-band--pink">
    <div class="govbb-width-container govbb-start-guide">
      <div class="govbb-start-guide__intro">
        <h2 class="govbb-section-title">Choose where to start</h2>
        <p>Follow the path that matches the decision your team needs to make.</p>
      </div>
      <ul class="govbb-start-list">
        {
          startPaths.map((path) => (
            <li>
              <a href={path.href}>
                <div>
                  <h3>{path.title}</h3>
                  <p>{path.desc}</p>
                </div>
                <span>{path.link}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
