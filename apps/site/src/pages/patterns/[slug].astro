---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Example from '../../components/Example.astro';
import { getPatternsSidebar } from '../../data/nav';
import { buildExampleBlocks } from '../../lib/example-blocks';
import { pageSource } from '../../lib/page-source';
import { getContentNeighbors } from '../../lib/content-navigation';

export async function getStaticPaths() {
  const entries = await getCollection('patterns');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { headings } = await render(entry);

// "On this page" nav derived from the markdown's h2 headings.
const onThisPage = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ label: h.text, href: `#${h.slug}` }));

const blocks = buildExampleBlocks(entry, { introBeforeFirstExample: true });
const entries = await getCollection('patterns');
entries.sort((a, b) => a.data.title.localeCompare(b.data.title));
const neighbors = getContentNeighbors(entries, entry.id, '/patterns/');
---

<ArticleLayout
  title={entry.data.title}
  section="patterns"
  description={entry.data.description}
  pageTitle={entry.data.title}
  pageSubtitle={entry.data.lede}
  sidebarGroups={await getPatternsSidebar()}
  sidebarLabel="Patterns"
  source={pageSource('patterns', entry.id)}
  onThisPage={onThisPage}
  breadcrumbs={[
    { label: 'Patterns', href: '/patterns/' },
    { label: entry.data.group },
  ]}
  meta={[
    { label: 'Purpose', value: entry.data.group },
    { label: 'Example', value: 'Working HTML' },
  ]}
  previous={neighbors.previous}
  next={neighbors.next}
>
  <div class="govbb-prose">
    {
      blocks.map((block) =>
        block.example ? (
          <Example
            html={block.example.html}
            react={block.example.react}
            title={block.example.title}
          />
        ) : (
          <Fragment set:html={block.prose} />
        ),
      )
    }

  </div>
</ArticleLayout>
