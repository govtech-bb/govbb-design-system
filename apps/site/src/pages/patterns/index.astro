---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection } from 'astro:content';
import { getPatternsSidebar } from '../../data/nav';

const GROUP_ORDER = ['Ask users for', 'Help users to'] as const;
const entries = await getCollection('patterns');
entries.sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<ArticleLayout
  title="Patterns"
  section="patterns"
  description="Best-practice ways to handle common tasks in government services, composed from the components."
  pageTitle="Patterns"
  pageSubtitle="Best-practice ways to handle common tasks in government services, composed from the components."
  sidebarGroups={await getPatternsSidebar()}
  sidebarLabel="Patterns"
>
  <div class="govbb-prose">
    <p>
      Patterns document how to combine components into a proven solution for a
      whole task, such as asking for an address or letting people check their
      answers before submitting.
    </p>
    {
      GROUP_ORDER.map((group) => (
        <>
          <h2>{group}&hellip;</h2>
          <ul>
            {entries
              .filter((e) => e.data.group === group)
              .map((entry) => (
                <li>
                  <a href={`/patterns/${entry.id}/`}>{entry.data.title}</a> -{' '}
                  {entry.data.lede}
                </li>
              ))}
          </ul>
        </>
      ))
    }
  </div>
</ArticleLayout>
