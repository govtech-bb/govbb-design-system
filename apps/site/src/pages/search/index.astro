---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBar from '../../components/SearchBar.astro';
import { primaryNav, secondaryNav } from '../../data/nav';
---
<BaseLayout
  title="Search the design system"
  description="Search the GovBB Design System."
>
  {/* The search page itself shouldn't appear in its own results. */}
  <section
    class="govbb-width-container govbb-page-section govbb-search-page"
    data-pagefind-ignore
  >
    <div class="govbb-page-header">
      <h1 class="govbb-page-title">Search</h1>
      <p class="govbb-page-subtitle">
        Find components, patterns, templates and implementation guidance.
      </p>
    </div>

    <div class="govbb-search-task">
      <p class="govbb-search-task__label">Search the design system</p>
      {/* Static build: the query lives in the URL and is read client-side. */}
      <SearchBar
        borderless
        label="Search the design system"
        placeholder="For example, button or typography…"
      />
      <p class="govbb-search-task__hint">
        Search by component name, user need or topic.
      </p>
    </div>

    <div class="govbb-search-layout">
      <section
        id="search-results-region"
        class="govbb-search-results"
        aria-labelledby="search-results-heading"
      >
        <h2 id="search-results-heading" class="govbb-search-results__heading">
          Search results
        </h2>
        <p
          id="search-status"
          class="govbb-search-status"
          role="status"
          aria-live="polite"
        >
          Enter a word or phrase to find guidance across the site.
        </p>

        <div id="search-empty" class="govbb-search-empty" hidden>
          <h3 id="search-empty-title">No matching pages</h3>
          <p id="search-empty-message">
            Check the spelling or try a shorter, more general search term.
          </p>
        </div>

        <ul id="search-results" class="govbb-search-list" hidden></ul>
        <button
          id="search-more"
          class="govbb-button govbb-button--secondary govbb-search-more"
          type="button"
          aria-controls="search-results"
          hidden
        >
          Show more results
        </button>
      </section>

      <aside class="govbb-search-browse" aria-labelledby="browse-heading">
        <h2 id="browse-heading">Browse by section</h2>
        <nav aria-label="Design system sections">
          <ul>
            {[...primaryNav, ...secondaryNav].map((item) => (
              <li>
                <a href={item.href}>
                  <span>{item.label}</span>
                  <small>{item.description}</small>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .govbb-search-page {
    container-type: inline-size;
  }
  .govbb-search-task {
    max-width: 50rem;
    padding: var(--govbb-space-4);
    background: var(--govbb-color-panel);
    border: 1px solid var(--govbb-color-border);
  }
  .govbb-search-task__label {
    margin: 0 0 var(--govbb-space-2);
    font-weight: 700;
  }
  .govbb-search-task__hint {
    margin: var(--govbb-space-2) 0 0;
    color: var(--govbb-color-text-muted);
    font-size: 0.9375rem;
  }
  .govbb-search-layout {
    display: grid;
    grid-template-columns: minmax(0, 46rem) minmax(15rem, 20rem);
    gap: var(--govbb-space-8);
    align-items: start;
    margin-top: var(--govbb-space-6);
  }
  .govbb-search-results {
    min-width: 0;
  }
  .govbb-search-results__heading,
  .govbb-search-browse h2 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.25;
  }
  .govbb-search-status {
    min-height: 1.7em;
    margin: var(--govbb-space-2) 0 var(--govbb-space-4);
    color: var(--govbb-color-text-muted);
  }
  .govbb-search-empty {
    margin-top: var(--govbb-space-4);
    padding: var(--govbb-space-4);
    border: 1px solid var(--govbb-color-border);
    background: color-mix(
      in oklab,
      var(--govbb-color-panel),
      var(--govbb-color-white) 45%
    );
  }
  .govbb-search-empty h3,
  .govbb-search-empty p {
    margin: 0;
  }
  .govbb-search-empty p {
    margin-top: var(--govbb-space-2);
    color: var(--govbb-color-text-muted);
  }
  .govbb-search-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--govbb-color-border);
  }
  .govbb-search-list li {
    padding-block: var(--govbb-space-4);
    border-bottom: 1px solid var(--govbb-color-border);
  }
  .govbb-search-more {
    margin-top: var(--govbb-space-4);
  }
  .govbb-result__section {
    margin: 0 0 var(--govbb-space-1);
    color: var(--govbb-color-text-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .govbb-result__title {
    display: inline;
    color: var(--govbb-color-link);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }
  .govbb-result__title:hover {
    color: var(--govbb-color-link-hover);
    text-decoration-thickness: 0.12em;
  }
  .govbb-result__excerpt {
    max-width: 64ch;
    margin: var(--govbb-space-2) 0 0;
    color: var(--govbb-color-text-muted);
    text-wrap: pretty;
  }
  .govbb-search-browse {
    padding-top: var(--govbb-space-1);
  }
  .govbb-search-browse ul {
    list-style: none;
    margin: var(--govbb-space-3) 0 0;
    padding: 0;
    border-top: 1px solid var(--govbb-color-border);
  }
  .govbb-search-browse li {
    border-bottom: 1px solid var(--govbb-color-border);
  }
  .govbb-search-browse a {
    display: block;
    padding-block: var(--govbb-space-3);
    color: var(--govbb-color-text);
    text-decoration: none;
  }
  .govbb-search-browse a:hover span {
    color: var(--govbb-color-link-hover);
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.15em;
  }
  .govbb-search-browse span {
    display: block;
    color: var(--govbb-color-link);
    font-weight: 700;
  }
  .govbb-search-browse small {
    display: block;
    margin-top: var(--govbb-space-1);
    color: var(--govbb-color-text-muted);
    font-size: 0.875rem;
    line-height: 1.35;
    text-wrap: pretty;
  }
  @container (width < 58rem) {
    .govbb-search-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--govbb-space-6);
    }
    .govbb-search-browse {
      max-width: 46rem;
    }
  }
  @container (width < 35rem) {
    .govbb-search-task {
      margin-inline: calc(-1 * var(--govbb-space-3));
      padding-inline: var(--govbb-space-3);
    }
  }
</style>

<script>
  interface PagefindData {
    url: string;
    excerpt?: string;
    meta?: {
      title?: string;
      description?: string;
      maturity?: string;
      accessibility?: string;
    };
  }

  interface PagefindResult {
    data: () => Promise<PagefindData>;
  }

  interface PagefindSearch {
    results: PagefindResult[];
  }

  interface PagefindModule {
    init?: () => Promise<void>;
    search: (query: string) => Promise<PagefindSearch>;
  }

  const params = new URLSearchParams(window.location.search);
  const query = (params.get('q') ?? '').trim();

  const input = document.getElementById('search') as HTMLInputElement | null;
  const status = document.getElementById('search-status');
  const list = document.getElementById('search-results');
  const empty = document.getElementById('search-empty');
  const emptyTitle = document.getElementById('search-empty-title');
  const emptyMessage = document.getElementById('search-empty-message');
  const more = document.getElementById('search-more') as HTMLButtonElement | null;
  const resultsRegion = document.getElementById('search-results-region');

  const getSectionLabel = (url: string) => {
    const section = new URL(url, window.location.origin).pathname
      .split('/')
      .filter(Boolean)[0];
    const labels = new Map([
      ['documentation', 'Get started'],
      ['styles', 'Styles'],
      ['components', 'Components'],
      ['patterns', 'Patterns'],
      ['templates', 'Templates'],
      ['design-log', 'Design log'],
    ]);
    return section ? (labels.get(section) ?? 'Design system') : 'Design system';
  };

  const cleanExcerpt = (excerpt: string) => {
    const wrapper = document.createElement('div');
    wrapper.innerHTML = excerpt;
    return (wrapper.textContent ?? '')
      .replace(/<[^>]+>/g, ' ')
      .replace(/\b(?:Preview|Code|View source|View as Markdown|Open in new)\b/gi, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  };

  // Load Pagefind's runtime bundle (generated into /pagefind at build time);
  // @vite-ignore stops Vite resolving or preloading it during the site build.
  const importPagefind = (path: string): Promise<PagefindModule> =>
    import(/* @vite-ignore */ path);

  if (query && input && status && list && more) {
    input.value = query;
    status.textContent = `Searching for “${query}”…`;
    resultsRegion?.setAttribute('aria-busy', 'true');

    (async () => {
      try {
        const pagefind = await importPagefind('/pagefind/pagefind.js');
        await pagefind.init?.();
        const search = await pagefind.search(query);
        const total = search.results.length;
        const pageSize = 12;
        let shown = 0;

        if (total === 0) {
          status.textContent = `No results found for “${query}”.`;
          if (emptyTitle) emptyTitle.textContent = 'No matching pages';
          if (emptyMessage) {
            emptyMessage.textContent =
              'Check the spelling or try a shorter, more general search term.';
          }
          if (empty) empty.hidden = false;
          return;
        }

        const renderNextPage = async () => {
          const results = await Promise.all(
            search.results
              .slice(shown, shown + pageSize)
              .map((result) => result.data()),
          );

          list.append(
            ...results.map((data) => {
              const li = document.createElement('li');
              const article = document.createElement('article');
              const section = document.createElement('p');
              section.className = 'govbb-result__section';
              section.textContent = getSectionLabel(data.url);
              const a = document.createElement('a');
              a.className = 'govbb-result__title';
              a.href = data.url;
              a.textContent = data.meta?.title ?? data.url;
              const p = document.createElement('p');
              p.className = 'govbb-result__excerpt';
              p.textContent =
                data.meta?.description ?? cleanExcerpt(data.excerpt ?? '');
              article.append(section, a);
              if (p.textContent) article.append(p);
              li.append(article);
              return li;
            }),
          );

          shown += results.length;
          list.hidden = false;
          const remaining = total - shown;
          status.textContent =
            remaining > 0
              ? `Showing ${shown} of ${total} results for “${query}”.`
              : `${total} result${total === 1 ? '' : 's'} for “${query}”.`;
          more.hidden = remaining === 0;
          more.textContent =
            remaining > pageSize
              ? `Show ${pageSize} more results`
              : `Show ${remaining} more result${remaining === 1 ? '' : 's'}`;
        };

        await renderNextPage();
        more.addEventListener('click', async () => {
          more.disabled = true;
          more.textContent = 'Loading…';
          resultsRegion?.setAttribute('aria-busy', 'true');
          try {
            await renderNextPage();
          } catch {
            status.textContent = 'More results could not be loaded. Try again.';
            more.textContent = 'Try loading more results';
          } finally {
            more.disabled = false;
            resultsRegion?.removeAttribute('aria-busy');
          }
        });
      } catch {
        status.textContent =
          'Search is temporarily unavailable. Browse by section or try again.';
        if (emptyTitle) emptyTitle.textContent = 'Search unavailable';
        if (emptyMessage) {
          emptyMessage.textContent =
            'Use the section links on this page, or try searching again later.';
        }
        if (empty) empty.hidden = false;
        more.hidden = true;
      } finally {
        resultsRegion?.removeAttribute('aria-busy');
      }
    })();
  }
</script>
