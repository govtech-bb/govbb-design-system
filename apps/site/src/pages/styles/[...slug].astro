---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Example from '../../components/Example.astro';
import { getStylesSidebar } from '../../data/nav';
import { buildExampleBlocks } from '../../lib/example-blocks';

export async function getStaticPaths() {
  const entries = await getCollection('styles');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const onThisPage = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ label: h.text, href: `#${h.slug}` }));

// Pages that opt in via `examples: true` get their ```html fences rendered as
// live previews; the rest (whose fences are page-level scaffolds) render as
// plain code blocks.
const blocks = entry.data.examples ? buildExampleBlocks(entry) : null;
---

<ArticleLayout
  title={entry.data.title}
  section="styles"
  description={entry.data.description}
  pageTitle={entry.data.title}
  pageSubtitle={entry.data.lede}
  sidebarGroups={await getStylesSidebar()}
  sidebarLabel="Styles"
  onThisPage={onThisPage}
>
  <div class="govbb-prose govbb-prose--article">
    {
      blocks ? (
        blocks.map((block) =>
          block.example ? (
            <Example
              html={block.example.html}
              react={block.example.react}
              title={block.example.title}
            />
          ) : (
            <Fragment set:html={block.prose} />
          ),
        )
      ) : (
        <Content />
      )
    }
  </div>
</ArticleLayout>
