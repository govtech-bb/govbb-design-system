---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Example from '../../components/Example.astro';
import TokenDemo from '../../components/TokenDemo.astro';
import TokenTable from '../../components/TokenTable.astro';
import { getStylesSidebar } from '../../data/nav';
import { buildExampleBlocks } from '../../lib/example-blocks';
import { buildTokenBlocks } from '../../lib/token-blocks';
import { pageSource } from '../../lib/page-source';
import { select, withAliasNotes } from '../../lib/tokens';
import { getContentNeighbors } from '../../lib/content-navigation';

export async function getStaticPaths() {
  const entries = await getCollection('styles');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const onThisPage = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ label: h.text, href: `#${h.slug}` }));

// Pages that opt in via `examples: true` get their ```html fences rendered as
// live previews; pages with ```token-table fences get generated token tables
// (see lib/token-blocks.ts); the rest render their fences as plain code.
const tokenBlocks =
  entry.body?.includes('```token-table') || entry.body?.includes('```token-demo')
    ? buildTokenBlocks(entry)
    : null;
const blocks =
  !tokenBlocks && entry.data.examples ? buildExampleBlocks(entry) : null;
const entries = await getCollection('styles');
entries.sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const neighbors = getContentNeighbors(entries, entry.id, '/styles/');
const parentLabel = entry.id.includes('/')
  ? entry.id.split('/')[0].replace(/^./, (character) => character.toUpperCase())
  : 'Foundations';
---

<ArticleLayout
  title={entry.data.title}
  section="styles"
  description={entry.data.description}
  pageTitle={entry.data.title}
  pageSubtitle={entry.data.lede}
  sidebarGroups={await getStylesSidebar()}
  sidebarLabel="Styles"
  source={pageSource('styles', entry.id)}
  onThisPage={onThisPage}
  breadcrumbs={[
    { label: 'Styles', href: '/styles/' },
    { label: parentLabel },
  ]}
  meta={[
    { label: 'Type', value: entry.body?.includes('```token-') ? 'Token reference' : 'Foundation guidance' },
  ]}
  previous={neighbors.previous}
  next={neighbors.next}
>
  <div class="govbb-prose">
    {
      tokenBlocks ? (
        tokenBlocks.map((block) =>
          block.demo ? (
            <TokenDemo />
          ) : block.table ? (
            <TokenTable
              tokens={
                block.table.notes === 'aliased-by'
                  ? withAliasNotes(select(block.table.tokens))
                  : select(block.table.tokens)
              }
              kind={block.table.kind}
              contrast={block.table.contrast}
              aliases={block.table.aliases}
              notesHeader={
                block.table.notes === 'aliased-by' ? 'Aliased by' : undefined
              }
              label={block.table.label ?? 'Design tokens'}
            />
          ) : (
            <Fragment set:html={block.prose} />
          ),
        )
      ) : blocks ? (
        blocks.map((block) =>
          block.example ? (
            <Example
              html={block.example.html}
              react={block.example.react}
              title={block.example.title}
            />
          ) : (
            <Fragment set:html={block.prose} />
          ),
        )
      ) : (
        <Content />
      )
    }
  </div>
</ArticleLayout>
