---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import CardGrid from '../../components/CardGrid.astro';
import type { CardData } from '../../components/CardGrid.astro';
import { getCollection } from 'astro:content';
import { getStylesSidebar } from '../../data/nav';

const modifiers = ['teal', 'pink', 'lavender'] as const;
// Cards show top-level pages only; nested pages (e.g. typography/lists)
// are reached from their parent's sidebar group.
const entries = (await getCollection('styles')).filter(
  (e) => !e.id.includes('/'),
);
entries.sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const cards: CardData[] = entries.map((entry, i) => ({
  title: entry.data.title,
  href: `/styles/${entry.id}/`,
  modifier: modifiers[i % modifiers.length],
  desc: entry.data.description,
  link: `View ${entry.data.title.toLowerCase()}`,
}));
---

<ArticleLayout
  title="Styles"
  section="styles"
  description="The visual language underneath the components: layout, colour, typography and spacing."
  pageTitle="Styles"
  pageSubtitle="The visual language underneath the components: layout, colour, typography and spacing."
  sidebarGroups={await getStylesSidebar()}
  sidebarLabel="Styles"
>
  <div class="govbb-prose">
    <p>
      Start with semantic tokens and shared rules before choosing individual values.
      Each foundation page pairs the design principle with implementation details.
    </p>
  </div>
  <CardGrid cards={cards} />
</ArticleLayout>
