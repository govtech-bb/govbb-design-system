---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Example from '../../components/Example.astro';
import { getTemplatesSidebar } from '../../data/nav';
import { buildExampleBlocks } from '../../lib/example-blocks';
import { exampleUrl, getTemplateExample } from '../../lib/template-examples';

export async function getStaticPaths() {
  const entries = await getCollection('templates');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { headings } = await render(entry);

// "On this page" nav: the preview the page renders first, then the markdown's
// h2 headings.
const onThisPage = [
  { label: 'Preview', href: '#preview' },
  ...headings
    .filter((h) => h.depth === 2)
    .map((h) => ({ label: h.text, href: `#${h.slug}` })),
];

const blocks = buildExampleBlocks(entry);
---

<ArticleLayout
  title={entry.data.title}
  section="templates"
  description={entry.data.description}
  pageTitle={entry.data.title}
  pageSubtitle={entry.data.lede}
  sidebarGroups={await getTemplatesSidebar()}
  sidebarLabel="Templates"
  onThisPage={onThisPage}
>
  <div class="govbb-prose govbb-prose--article">
    <h2 id="preview">Preview</h2>
    {/* The whole-page example is a real route rendered into the preview
        iframe; the same markup (src/examples/templates/<slug>.html) fills
        the code panel, so preview and source cannot drift. */}
    <Example
      src={exampleUrl(entry.id)}
      html={getTemplateExample(entry.id)}
      title={entry.data.title}
    />
    {
      blocks.map((block) =>
        block.example ? (
          <Example
            html={block.example.html}
            react={block.example.react}
            title={block.example.title}
          />
        ) : (
          <Fragment set:html={block.prose} />
        ),
      )
    }
  </div>
</ArticleLayout>
