{
  "name": "govbb-design-system",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "lightningcss --bundle --minify --browserslist src/index.css -o dist/govbb.css",
    "site:dev": "pnpm --filter @govbb/site dev",
    "site:build": "pnpm --filter @govbb/site build",
    "lint": "oxlint && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "lefthook": "^2.1.9",
    "lightningcss-cli": "^1.30.2",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.3",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.1.0"
  }
}
