{
  "name": "govbb-design-system",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @govtech-bb/frontend dev",
    "build": "pnpm -r build",
    "site:dev": "pnpm --filter @govbb/site dev",
    "site:build": "pnpm --filter @govbb/site build",
    "lint": "oxlint && stylelint \"packages/*/src/**/*.css\"",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changelog": "git-cliff --output CHANGELOG.md",
    "changelog:unreleased": "git-cliff --unreleased --tag unreleased --output CHANGELOG.md",
    "figma:sync": "node ci/figma/sync-tokens-to-figma.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "git-cliff": "^2.13.1",
    "lefthook": "^2.1.9",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.3",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
