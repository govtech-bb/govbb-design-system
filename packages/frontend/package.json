{
  "name": "@govtech-bb/frontend",
  "version": "0.0.0",
  "description": "GovBB Design System — CSS, tokens and progressive-enhancement JS. Framework-agnostic.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./css": "./dist/govbb.css",
    "./assets/*": "./assets/*"
  },
  "files": [
    "assets",
    "dist",
    "src",
    "!src/**/*.test.js",
    "index.js",
    "index.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "dev": "vite",
    "build": "lightningcss --bundle --minify --custom-media --browserslist src/index.css -o dist/govbb.css",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "lightningcss-cli": "^1.30.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
