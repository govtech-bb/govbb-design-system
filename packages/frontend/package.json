{
  "name": "@govtech-bb/frontend",
  "version": "1.0.0-alpha.27",
  "description": "GovBB Design System — CSS, tokens and progressive-enhancement JS. Framework-agnostic.",
  "repository": {
    "type": "git",
    "url": "https://github.com/govtech-bb/govbb-design-system.git",
    "directory": "packages/frontend"
  },
  "homepage": "https://design-system.gov.bb/",
  "bugs": "https://github.com/govtech-bb/govbb-design-system/issues",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./css": "./dist/govbb.css",
    "./tokens.css": "./src/tokens.css",
    "./assets/*": "./assets/*",
    "./tailwind": "./dist/tailwind.css"
  },
  "files": [
    "assets",
    "dist",
    "src",
    "!src/**/*.test.js",
    "index.js",
    "index.d.ts",
    "scripts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "dev": "vite",
    "build": "lightningcss --bundle --minify --custom-media --browserslist src/index.css -o dist/govbb.css && node scripts/build-tailwind-theme.mjs",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "lightningcss-cli": "^1.30.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
