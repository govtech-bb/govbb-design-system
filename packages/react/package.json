{
  "name": "@govtech-bb/react",
  "version": "1.0.0-alpha.29",
  "description": "GovBB Design System — React wrappers over the CSS. Thin, own-the-code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/govtech-bb/govbb-design-system.git",
    "directory": "packages/react"
  },
  "homepage": "https://design-system.gov.bb/",
  "bugs": "https://github.com/govtech-bb/govbb-design-system/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "MIGRATION.md",
    "src",
    "!src/**/*.test.tsx",
    "!src/testing"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@govtech-bb/frontend": "workspace:^",
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
